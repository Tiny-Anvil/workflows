<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <!-- Debug only: the dev-bypass type exists here and must be absent from Release (dotnet-build checks it). -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>$(DefineConstants);DEV_AUTH_BYPASS</DefineConstants>
  </PropertyGroup>
</Project>
